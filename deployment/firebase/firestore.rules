rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function hasSharedAccess(allowedOwners) {
      return isSignedIn() && request.auth.uid in allowedOwners;
    }

    match /metadataDocuments/{docId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.blobId is string
        && request.resource.data.terms is list;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    match /blobPayloads/{blobId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.payload is string
        && request.resource.data.encoding in ['base64', 'utf8'];
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    match /sharedContent/{docId} {
      allow read: if isOwner(resource.data.ownerId) || hasSharedAccess(resource.data.allowedOwners);
      allow create, update, delete: if isOwner(request.resource.data.ownerId);
    }

    match /users/{uid} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
