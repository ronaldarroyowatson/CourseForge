rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Blob payloads used by metadata+blob document storage pattern.
    match /courseforge/blobPayloads/{ownerId}/{textbookId}/{blobId} {
      allow read, write: if isOwner(ownerId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
