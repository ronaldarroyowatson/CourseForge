rules_version = '2';

// CourseForge v1.1 — Firestore Security Rules
//
// Canonical content hierarchy:
//   /textbooks/{textbookId}
//   /textbooks/{textbookId}/chapters/{chapterId}
//   /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}
//   /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/vocab/{vocabId}
//   /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/equations/{equationId}
//   /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/concepts/{conceptId}
//   /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/keyIdeas/{keyIdeaId}
//
// User profiles:
//   /users/{uid}
//
// Ownership is stored in the document's userId field, written by the sync
// engine on every cloud write. District admins are identified via custom JWT
// claims (request.auth.token.admin == true or request.auth.token.districtAdmin
// == true). District boundaries are enforced by request.auth.token.districtId.
// Super admins are identified by request.auth.token.superAdmin.
//
// Section-scoped content entities use the same ownership model as vocab.

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper functions
    // =========================================================================

    // Returns true when the caller has a valid Firebase Auth session.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true when the caller holds super admin privileges.
    function isSuperAdmin() {
      return request.auth != null
        && 'superAdmin' in request.auth.token
        && request.auth.token.superAdmin == true;
    }

    // Returns true when the caller holds district admin privileges.
    // Backward compatibility: the legacy `admin` claim maps to district admin
    // behavior for Firestore read scoping.
    function isDistrictAdmin() {
      return request.auth != null && (
        ('districtAdmin' in request.auth.token && request.auth.token.districtAdmin == true) ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    // Returns caller districtId from token, or an empty string when missing.
    function callerDistrictId() {
      return isSignedIn()
        && 'districtId' in request.auth.token
        && request.auth.token.districtId is string
        ? request.auth.token.districtId
        : "";
    }

    // Returns districtId from /users/{uid}, or an empty string when missing.
    function districtIdForUser(uid) {
      return uid is string
        && uid != ""
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.districtId is string
        ? get(/databases/$(database)/documents/users/$(uid)).data.districtId
        : "";
    }

    // Returns true when caller claim and target user resolve to the same
    // non-empty district.
    function isSameDistrict(targetUid) {
      return targetUid is string
        && targetUid != ""
        && callerDistrictId() != ""
        && callerDistrictId() == districtIdForUser(targetUid);
    }

    // Extracts the content owner uid from canonical owner fields.
    function ownerUid(data) {
      return (
        ('ownerId' in data && data.ownerId is string && data.ownerId != "")
          ? data.ownerId
          : (
            ('userId' in data && data.userId is string && data.userId != "")
              ? data.userId
              : ""
          )
      );
    }

    // District admins may read docs owned by users in their district.
    function districtAdminCanReadOwnerData(data) {
      return isDistrictAdmin()
        && isSignedIn()
        && ownerUid(data) != ""
        && isSameDistrict(ownerUid(data));
    }

    // Returns true when the authenticated uid matches owner fields on data.
    function ownerMatches(data) {
      return isSignedIn() && (
        ('userId' in data && request.auth.uid == data.userId) ||
        ('ownerId' in data && request.auth.uid == data.ownerId)
      );
    }

    // Returns true when the caller can write an owned document.
    // CREATE checks incoming ownership, UPDATE/DELETE check existing ownership.
    function isOwner() {
      return resource == null
        ? ownerMatches(request.resource.data)
        : ownerMatches(resource.data);
    }

    // Owners may update their own profile while privileged scope fields stay
    // token-bound or immutable from the client.
    function canOwnerWriteOwnProfile(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && (
          !('districtName' in request.resource.data)
          || (resource != null && request.resource.data.districtName == resource.data.districtName)
        )
        && (
          !('districtId' in request.resource.data)
          || (
            (
              callerDistrictId() != ""
              && request.resource.data.districtId == callerDistrictId()
            )
            || (
              resource != null
              && 'districtId' in resource.data
              && request.resource.data.districtId == resource.data.districtId
            )
          )
        )
        && (
          !('schoolName' in request.resource.data)
          || (resource != null && request.resource.data.schoolName == resource.data.schoolName)
        )
        && (
          !('isAdmin' in request.resource.data)
          || request.resource.data.isAdmin == (
            'admin' in request.auth.token && request.auth.token.admin == true
          )
        )
        && (
          !('isSchoolAdmin' in request.resource.data)
          || request.resource.data.isSchoolAdmin == (
            'schoolAdmin' in request.auth.token && request.auth.token.schoolAdmin == true
          )
        )
        && (
          !('isSuperAdmin' in request.resource.data)
          || request.resource.data.isSuperAdmin == (
            'superAdmin' in request.auth.token && request.auth.token.superAdmin == true
          )
        )
        && (
          !('schoolId' in request.resource.data)
          || (
            (
              'schoolId' in request.auth.token
              && request.auth.token.schoolId is string
              && request.resource.data.schoolId == request.auth.token.schoolId
            )
            || (
              resource != null
              && 'schoolId' in resource.data
              && request.resource.data.schoolId == resource.data.schoolId
            )
          )
        );
    }

    // Returns true when the caller may READ a content document.
    // Restricts reads to:
    // - the document owner
    // - district admins for in-district owners
    // - super admins
    function isOwnerRead() {
      return isSuperAdmin() || ownerMatches(resource.data) || districtAdminCanReadOwnerData(resource.data);
    }

    // =========================================================================
    // /users/{uid}
    //
    // User profile documents. Written by auth.ts (saveUserProfileToFirestore)
    // on every sign-in and by the setUserAdminStatus Cloud Function.
    // Read on login to restore the user's theme preference.
    //
    // Fields: uid, displayName, email, isAdmin, lastLoginAt, theme,
    //         lastClaimsUpdatedAt
    //
    // - Owner can read and update their own profile.
    // - District admins can read users within their district.
    // - Super admins can read and write any profile.
    // - All sub-collections under /users/{uid}/ are explicitly blocked to
    //   prevent accidental legacy writes (users/{uid}/sections, /chapters,
    //   /textbooks, /vocabTerms created by the old sync engine).
    // =========================================================================
    match /users/{uid} {
      allow read:  if isSignedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || (isDistrictAdmin() && isSameDistrict(uid))
      );
      allow write: if canOwnerWriteOwnProfile(uid) || isSuperAdmin();

      // Premium usage tracking: owners can read, only admins can mutate.
      match /premiumUsage/{docId} {
        allow read:  if isSignedIn() && (
          request.auth.uid == uid
          || isSuperAdmin()
          || (isDistrictAdmin() && isSameDistrict(uid))
        );
        allow write: if isSuperAdmin();
      }

      // Explicitly block legacy sub-collections written by the pre-v1.1 sync engine.
      match /textbooks/{docId} {
        allow read:  if false;
        allow write: if false;
      }

      match /chapters/{docId} {
        allow read:  if false;
        allow write: if false;
      }

      match /sections/{docId} {
        allow read:  if false;
        allow write: if false;
      }

      match /vocabTerms/{docId} {
        allow read:  if false;
        allow write: if false;
      }

      // Block any other unexpected sub-collection under /users/{uid}.
      match /{legacyCollection}/{docId} {
        allow read:  if false;
        allow write: if false;
      }

      // Deny deeply nested sub-paths too.
      match /{legacyCollection}/{docId}/{rest=**} {
        allow read:  if false;
        allow write: if false;
      }
    }

    // =========================================================================
    // /textbooks/{textbookId}
    //
    // Top-level textbook documents.
    //
    // Fields: userId, title, grade, subject, edition, publicationYear,
    //         isbnRaw, isbnNormalized, platformUrl, createdAt, updatedAt,
    //         lastModified, pendingSync, source, isFavorite, isArchived,
    //         status, isDeleted
    //
    // Read policy  : document owner, district admin for in-district owners,
    //                or super admin.
    // Write policy : owner (userId matches) or super admin.
    // =========================================================================
    match /textbooks/{textbookId} {
      allow read:   if isOwnerRead();
      allow write:  if isOwner() || isSuperAdmin();

      // -----------------------------------------------------------------------
      // /textbooks/{textbookId}/chapters/{chapterId}
      //
      // Fields: userId, textbookId, index, name, description, lastModified,
      //         pendingSync, source, status, isDeleted
      // -----------------------------------------------------------------------
      match /chapters/{chapterId} {
        allow read:   if isOwnerRead();
        allow write:  if isOwner() || isSuperAdmin();

        // ---------------------------------------------------------------------
        // /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}
        //
        // Fields: userId, textbookId, chapterId, index, title, notes,
        //         lastModified, pendingSync, source, status, isDeleted
        // ---------------------------------------------------------------------
        match /sections/{sectionId} {
          allow read:   if isOwnerRead();
          allow write:  if isOwner() || isSuperAdmin();

          // -------------------------------------------------------------------
          // /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/vocab/{vocabId}
          //
          // Fields: userId, textbookId, chapterId, sectionId, word, definition,
          //         altDefinitions, lastModified, pendingSync, source,
          //         status, isDeleted
          // -------------------------------------------------------------------
          match /vocab/{vocabId} {
            allow read:   if isOwnerRead();
            allow write:  if isOwner() || isSuperAdmin();
          }

          // -------------------------------------------------------------------
          // /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/equations/{equationId}
          // -------------------------------------------------------------------
          match /equations/{equationId} {
            allow read:   if isOwnerRead();
            allow write:  if isOwner() || isSuperAdmin();
          }

          // -------------------------------------------------------------------
          // /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/concepts/{conceptId}
          // -------------------------------------------------------------------
          match /concepts/{conceptId} {
            allow read:   if isOwnerRead();
            allow write:  if isOwner() || isSuperAdmin();
          }

          // -------------------------------------------------------------------
          // /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/keyIdeas/{keyIdeaId}
          // -------------------------------------------------------------------
          match /keyIdeas/{keyIdeaId} {
            allow read:   if isOwnerRead();
            allow write:  if isOwner() || isSuperAdmin();
          }

          // -------------------------------------------------------------------
          // /textbooks/{textbookId}/chapters/{chapterId}/sections/{sectionId}/presentations/{presentationId}
          //
          // Extracted and redesigned PowerPoint artifacts.
          // -------------------------------------------------------------------
          match /presentations/{presentationId} {
            allow read:   if isOwnerRead();
            allow write:  if isOwner() || isSuperAdmin();
          }
        }
      }
    }

    // =========================================================================
    // /debugReports/{userId}/reports/{reportId}
    //
    // Debug logs are written only by privileged callable functions (Admin SDK)
    // after server-side payload validation and size enforcement.
    // =========================================================================
    match /debugReports/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || (isDistrictAdmin() && isSameDistrict(userId))
      );
      allow write: if false;

      match /reports/{reportId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId
          || isSuperAdmin()
          || (isDistrictAdmin() && isSameDistrict(userId))
        );
        allow write: if false;
      }
    }

    // =========================================================================
    // /config/* and /apiRateLimits/*
    //
    // Security-critical policy and throttle state documents are server-owned.
    // Clients must never read or write these rows directly.
    // =========================================================================
    match /config/{docId} {
      allow read:  if false;
      allow write: if false;

      match /{rest=**} {
        allow read:  if false;
        allow write: if false;
      }
    }

    match /apiRateLimits/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    // =========================================================================
    // Catch-all deny rule
    //
    // Any path not explicitly matched above is denied for both reads and
    // writes. This covers:
    //   - Remnant data at /users/{uid}/sections, /chapters, /vocabTerms
    //     (also covered above, belt-and-suspenders)
    //   - Any new collection accidentally created outside the canonical schema
    //   - Direct client attempts to write to unrecognised paths
    //
    // Firestore evaluates rules from most specific to least specific, so
    // explicit allow rules above take precedence over this catch-all.
    // =========================================================================
    match /{document=**} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
